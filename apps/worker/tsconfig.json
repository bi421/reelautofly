{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@reelautofly/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@reelautofly/db": [
        "../../packages/db/src/index.ts"
      ],
      "@reelautofly/publisher": [
        "../publisher/src/index.ts"
      ],
      "@reelautofly/remotion-templates": [
        "../../packages/remotion-templates/src/index.ts"
      ]
    },
    "jsx": "preserve"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
